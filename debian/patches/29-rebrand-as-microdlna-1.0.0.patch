+/* Handler for the SIGTERM signal (kill) 
+ * SIGINT is also handled */
+static void
+sigterm(int sig)
+{
+	signal(sig, SIG_IGN);	/* Ignore this signal while we are quitting */
+
+	DPRINTF(E_WARN, L_GENERAL, "received signal %d, good-bye\n", sig);
+
+	quitting = 1;
+}
