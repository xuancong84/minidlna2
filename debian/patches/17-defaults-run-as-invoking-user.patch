Description: Default to root_container=B and to running as the invoking user
 runtime_vars.root_container now defaults to "B" (Browse Directory). An empty
 db_dir= selects live folder mode instead of failing, and an empty user=
 keeps running as the user that started minidlnad.
 .
 When an ordinary user starts the daemon and cannot write the default log
 directory or pid file location, per-user ones are used instead:
 $XDG_STATE_HOME/minidlna (or ~/.local/state/minidlna) for the log and
 $XDG_RUNTIME_DIR/minidlna for the pid file. Previously the daemon exited
 silently after daemonizing. The sample configuration spells out the new
 defaults: user=, db_dir=, inotify=yes, root_container=B.
Forwarded: no
Last-Update: 2026-10-21
--- a/minidlna.c
+++ b/minidlna.c
@@ -503,6 +503,24 @@ writepidfile(const char *fname, int pid,
 	return ret;
 }
 
+/* Per-user fallback directory for an unprivileged daemon,
+ * e.g. $XDG_STATE_HOME/minidlna or ~/.local/state/minidlna */
+static int
+user_dir(char *buf, size_t len, const char *xdg_var, const char *home_sub)
+{
+	const char *base = getenv(xdg_var);
+	const char *home = getenv("HOME");
+
+	if (base && base[0] == '/')
+		snprintf(buf, len, "%s/minidlna", base);
+	else if (home && home[0] == '/')
+		snprintf(buf, len, "%s/%s/minidlna", home, home_sub);
+	else
+		return -1;
+
+	return make_dir(buf, S_IRWXU);
+}
