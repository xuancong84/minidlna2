+/* Put a job first in its queue, queued already or not */
+static void
+move_to_front(struct queue *q, struct job *j)
+{
+	struct job **p = &q->head, *prev = NULL;
+
+	while (*p && *p != j)
+	{
+		prev = *p;
+		p = &(*p)->next;
+	}
+	if (!*p || q->head == j)
+		return;
+	*p = j->next;
+	if (q->tail == j)
+		q->tail = prev;
+	j->next = q->head;
+	q->head = j;
+}
