#!/bin/sh
# postrm script for microdlna

set -e

case "$1" in
    purge)
        rm -rf /var/cache/microdlna /var/log/microdlna
        rm -f /var/log/microdlna.log*
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
